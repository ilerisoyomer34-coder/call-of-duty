# Demir Şafak sunucusu — örnek ortam değişkenleri (gerçek değerler git'e girmez)
# Dinlenecek port ve adres (Caddy arkasında yalnız yerel adres yeterli)
PORT=8790
HOST=127.0.0.1
# Kalıcı veritabanı dosyası (yedeklenir)
DB_PATH=
# İzinli kökenler, virgülle (boş: GitHub Pages yayını). localhost her zaman izinli.
ALLOWED_ORIGINS=
# Yerel dosyadan açılan tek dosyalık sürüm (0: kapalı)
ALLOW_FILE_ORIGIN=
# Caddy gibi bir ters vekil arkasında 1
TRUST_PROXY=
